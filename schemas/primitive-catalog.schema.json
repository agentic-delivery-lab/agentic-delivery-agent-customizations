{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery-primitives/blob/main/schemas/primitive-catalog.schema.json",
  "title": "Agentic Primitive catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "architectureId", "primitives"],
  "properties": {
    "$schema": { "const": "../schemas/primitive-catalog.schema.json" },
    "schemaVersion": { "const": 1 },
    "architectureId": { "const": "urn:agentic-delivery:architecture:authority" },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "primitive.schema.json" }
    }
  }
}
