{
  "name": "@agentic-delivery/primitives",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "primitive:check": "node tools/validate-primitive-catalog.mjs",
