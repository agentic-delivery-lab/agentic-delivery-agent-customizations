{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery-primitives/blob/main/evaluations/contracts/evaluation-selection-policy.schema.json",
  "title": "Evaluation dataset selection policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "datasetId", "partition", "sampling", "registeredAt", "eligiblePopulation", "eligibleCaseIds", "includedCaseIds", "inclusionCriteria", "exclusions"],
  "properties": {
    "$schema": { "const": "../contracts/evaluation-selection-policy.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/slug" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "datasetId": { "$ref": "#/$defs/slug" },
    "partition": { "enum": ["development", "calibration", "validation", "holdout", "synthetic"] },
    "sampling": { "enum": ["census", "random", "stratified", "manual-pre-registered"] },
    "registeredAt": { "type": "string", "format": "date-time" },
    "eligiblePopulation": { "$ref": "#/$defs/nonEmptyString" },
    "eligibleCaseIds": { "$ref": "#/$defs/caseIds" },
    "includedCaseIds": { "$ref": "#/$defs/caseIds" },
    "inclusionCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["caseId", "rationale"],
        "properties": {
          "caseId": { "$ref": "#/$defs/slug" },
          "rationale": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "caseIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } }
  }
}
